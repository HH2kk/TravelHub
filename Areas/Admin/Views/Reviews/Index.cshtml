@model List<dynamic>
<h1>Đánh giá</h1>
<form method="get" class="filters-bar d-flex gap-2 flex-wrap"><select class="form-select" style="max-width:180px" name="stars" aria-label="Số sao" onchange="this.form.submit()"><option value="">Mọi điểm</option>@for (int s = 1; s <= 5; s++) { <option value="@s" @(ViewBag.Stars != null && (int)ViewBag.Stars == s ? "selected" : "")>@s sao</option> }</select>
 <select class="form-select" style="max-width:180px" name="status" aria-label="Hiển thị" onchange="this.form.submit()"><option value="">Tất cả</option><option value="1" @(ViewBag.Status == "1" ? "selected" : "")>Đang hiển thị</option><option value="0" @(ViewBag.Status == "0" ? "selected" : "")>Đã ẩn</option></select></form>
<div class="panel"><div class="tbl-wrap"><table class="tbl"><thead><tr><th>Điểm</th><th>Khách / chỗ nghỉ</th><th>Nội dung</th><th>Ngày</th><th>Trạng thái</th><th style="min-width:240px">Kiểm duyệt</th></tr></thead><tbody>
@foreach (var r in Model) { <tr><td>@Html.Stars((int)r.SoSao)</td><td>@r.HoTen<div class="small text-muted">@r.TenKS@(r.MaDonCode != null ? " · " + r.MaDonCode : "")</div></td><td class="small">@r.NoiDung @if ((bool)r.LaDuLieuMau) { <span class="chip gray">Dữ liệu mẫu</span> }</td><td class="small">@(((DateTime)r.NgayDanhGia).ToString("dd/MM/yyyy"))</td><td><span class="badge-st @((bool)r.TrangThai ? "ok" : "bad")">@((bool)r.TrangThai ? "Hiển thị" : "Đã ẩn")</span>@if (r.LyDoAn != null) { <div class="small">@r.LyDoAn</div> }</td>
 <td>@if ((bool)r.TrangThai) { using (Html.BeginForm("SetVisible", "Reviews", new { area = "Admin" }, FormMethod.Post, new { data_confirm = "Ẩn đánh giá này?" })) { @Html.AntiForgeryToken() <input type="hidden" name="id" value="@r.MaDanhGia" /><input type="hidden" name="visible" value="false" /><div class="input-group input-group-sm"><input name="reason" class="form-control" placeholder="Lý do ẩn (bắt buộc)" required /><button class="btn btn-outline-danger" type="submit">Ẩn</button></div> } } else { using (Html.BeginForm("SetVisible", "Reviews", new { area = "Admin" }, FormMethod.Post)) { @Html.AntiForgeryToken() <input type="hidden" name="id" value="@r.MaDanhGia" /><input type="hidden" name="visible" value="true" /><button class="btn btn-ghost btn-sm" type="submit">Hiện lại</button> } }</td></tr> }
@if (!Model.Any()) { <tr><td colspan="6" class="text-center text-muted py-4">Không có đánh giá.</td></tr> }</tbody></table></div></div>