@{ dynamic u = ViewBag.User; var roles = (List<dynamic>)ViewBag.Roles; var bks = (List<BookingListRow>)ViewBag.Bookings; var logs = (List<dynamic>)ViewBag.Logs; bool self = (int)u.MaTaiKhoan == Auth.Current.AccountId; }
<div class="ph"><div><div class="crumbs">@Html.ActionLink("Tài khoản", "Index") /</div><h1>@u.TenDangNhap <small class="text-muted fs-6">@u.HoTen</small></h1></div>@if (u.MaKH != null) { <a class="btn btn-primary btn-sm" href="@Url.Action("Details", "Customers", new { id = (int)u.MaKH })">@Html.Icon("users", 15) Hồ sơ khách 360° (đặt phòng, vé bay, thanh toán)</a> }</div>
<div class="row g-3"><div class="col-lg-5"><div class="panel mb-3"><h2>Hồ sơ</h2><dl class="row small mb-0"><dt class="col-4">Email</dt><dd class="col-8">@u.Email @((bool)u.EmailXacThuc ? "✓" : "(chưa xác minh)")</dd><dt class="col-4">Điện thoại</dt><dd class="col-8">@u.SoDienThoai</dd><dt class="col-4">Vai trò</dt><dd class="col-8">@u.TenVaiTro (@u.Role)</dd><dt class="col-4">Tạo lúc</dt><dd class="col-8">@(((DateTime)u.NgayTao).ToString("dd/MM/yyyy HH:mm"))</dd><dt class="col-4">Trạng thái</dt><dd class="col-8">@((bool)u.TrangThai ? "Hoạt động" : "Đã khóa")</dd></dl></div>
 <div class="panel"><h2>Quản lý</h2>
  @using (Html.BeginForm("SetActive", "Users", new { area = "Admin" }, FormMethod.Post, new { data_confirm = (bool)u.TrangThai ? "Vô hiệu hóa tài khoản này?" : "Mở khóa tài khoản?" })) { @Html.AntiForgeryToken() <input type="hidden" name="id" value="@u.MaTaiKhoan" /><input type="hidden" name="active" value="@((bool)u.TrangThai ? "false" : "true")" /><button class="btn @((bool)u.TrangThai ? "btn-outline-danger" : "btn-teal") w-100 mb-2" type="submit" @(self ? "disabled" : "")>@((bool)u.TrangThai ? "Khóa tài khoản" : "Mở khóa")</button> }
  @if (!(bool)u.EmailXacThuc) { using (Html.BeginForm("VerifyEmail", "Users", new { area = "Admin" }, FormMethod.Post, new { data_confirm = "Đánh dấu email đã xác minh thủ công?" })) { @Html.AntiForgeryToken() <input type="hidden" name="id" value="@u.MaTaiKhoan" /><button class="btn btn-ghost w-100 mb-2" type="submit">Xác minh email thủ công</button> } }
  @using (Html.BeginForm("SetRole", "Users", new { area = "Admin" }, FormMethod.Post, new { data_confirm = "Thay đổi vai trò của người dùng này?" })) { @Html.AntiForgeryToken() <input type="hidden" name="id" value="@u.MaTaiKhoan" /><label class="form-label small" for="roleId">Vai trò</label><div class="input-group"><select id="roleId" name="roleId" class="form-select" @(self ? "disabled" : "")>@foreach (var r in roles) { <option value="@r.MaVaiTro" @((int)r.MaVaiTro == (int)u.MaVaiTro ? "selected" : "")>@r.TenVaiTro</option> }</select><button class="btn btn-primary" type="submit" @(self ? "disabled" : "")>Đổi</button></div> }
  @if (self) { <div class="small text-muted mt-2">Bạn không thể tự khóa hoặc đổi quyền của chính mình.</div> } </div></div>
 <div class="col-lg-7"><div class="panel mb-3"><h2>Đặt phòng (@bks.Count)</h2><div class="tbl-wrap"><table class="tbl"><tbody>@foreach (var b in bks) { <tr><td><a href="@Url.Action("Details", "Bookings", new { id = b.Id })">@b.Code</a></td><td>@b.HotelName</td><td class="text-end">@Html.Money(b.Total)</td><td>@Html.StatusBadge(b.Status)</td></tr> }@if (!bks.Any()) { <tr><td class="text-muted">Chưa có đặt phòng.</td></tr> }</tbody></table></div></div>
  <div class="panel"><h2>Hoạt động gần đây</h2><ul class="list-unstyled small mb-0">@foreach (var l in logs) { <li class="border-top py-1"><strong>@l.HanhDong</strong> @l.DoiTuong <span class="text-muted">@(((DateTime)l.NgayTao).ToString("dd/MM HH:mm"))</span></li> }</ul></div></div></div>