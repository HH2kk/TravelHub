@model List<dynamic>
<div class="ph"><div><h1>Tài khoản</h1><div class="sub">Quản lý đăng nhập, vai trò và khóa tài khoản.</div></div></div>
<form method="get" class="filters-bar row g-2"><div class="col-md-5"><input class="form-control" name="q" value="@ViewBag.Q" placeholder="Tên đăng nhập / email / họ tên" aria-label="Tìm" /></div><div class="col-md-3"><select class="form-select" name="role" aria-label="Vai trò"><option value="">Mọi vai trò</option>@foreach (var r in new[] { "Traveler", "Partner", "Staff", "ContentManager", "Admin" }) { <option @(r == (string)ViewBag.Role ? "selected" : "")>@r</option> }</select></div><div class="col-md-2"><button class="btn btn-primary w-100" type="submit">Lọc</button></div></form>
<div class="panel"><div class="tbl-wrap"><table class="tbl"><thead><tr><th>Tài khoản</th><th>Họ tên</th><th>Email</th><th>Vai trò</th><th>Email xác minh</th><th>Trạng thái</th><th>Đăng nhập cuối</th></tr></thead><tbody>
@foreach (var u in Model) { <tr><td><a href="@Url.Action("Details", new { id = (int)u.MaTaiKhoan })"><strong>@u.TenDangNhap</strong></a></td><td>@u.HoTen</td><td>@u.Email</td><td><span class="chip gray">@u.Role</span></td><td>@((bool)u.EmailXacThuc ? "Đã xác minh" : "Chưa")</td><td><span class="badge-st @((bool)u.TrangThai ? "ok" : "bad")">@((bool)u.TrangThai ? "Hoạt động" : "Đã khóa")</span></td><td class="small">@(u.LanDangNhapCuoi == null ? "—" : ((DateTime)u.LanDangNhapCuoi).ToString("dd/MM/yyyy HH:mm"))</td></tr> }</tbody></table></div>@Html.Partial("_Pager")</div>