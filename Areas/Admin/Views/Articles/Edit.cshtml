@model TravelHub.Areas.Admin.Controllers.ArticleEditModel
@{ var dests = (List<DestinationItem>)ViewBag.Destinations; }
<h1>@ViewBag.Title</h1>
@using (Html.BeginForm("Save", "Articles", new { area = "Admin" }, FormMethod.Post, new { enctype = "multipart/form-data" })) { @Html.AntiForgeryToken() @Html.HiddenFor(m => m.Id) @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
<div class="panel"><div class="row g-3">
 <div class="col-12"><label class="form-label" for="TieuDe">Tiêu đề</label>@Html.TextBoxFor(m => m.TieuDe, new { @class = "form-control" })@Html.ValidationMessageFor(m => m.TieuDe)</div>
 <div class="col-12"><label class="form-label" for="MoTaNgan">Mô tả ngắn</label>@Html.TextAreaFor(m => m.MoTaNgan, 2, 40, new { @class = "form-control" })</div>
 <div class="col-12"><label class="form-label" for="NoiDung">Nội dung (văn bản; cách đoạn bằng một dòng trống)</label>@Html.TextAreaFor(m => m.NoiDung, 12, 40, new { @class = "form-control" })</div>
 <div class="col-md-4"><label class="form-label" for="MaDiaDiem">Điểm đến</label><select id="MaDiaDiem" name="MaDiaDiem" class="form-select"><option value="">— Không gắn —</option>@foreach (var d in dests) { <option value="@d.Id" @(Model.MaDiaDiem == d.Id ? "selected" : "")>@d.Name</option> }</select></div>
 <div class="col-md-4"><label class="form-label" for="DanhMuc">Danh mục</label>@Html.DropDownListFor(m => m.DanhMuc, new SelectList(new[] { "Kinh nghiệm", "Điểm đến", "Ẩm thực", "Mẹo du lịch" }, Model.DanhMuc), new { @class = "form-select" })</div>
 <div class="col-md-4"><label class="form-label" for="TacGia">Tác giả</label>@Html.TextBoxFor(m => m.TacGia, new { @class = "form-control" })</div>
 <div class="col-md-6"><label class="form-label" for="SeoTieuDe">SEO title</label>@Html.TextBoxFor(m => m.SeoTieuDe, new { @class = "form-control" })</div>
 <div class="col-md-6"><label class="form-label" for="SeoMoTa">SEO description</label>@Html.TextBoxFor(m => m.SeoMoTa, new { @class = "form-control" })</div>
 <div class="col-md-6"><label class="form-label" for="file">Ảnh bìa</label><input type="file" id="file" name="file" accept="image/jpeg,image/png,image/webp" class="form-control" />@if (!string.IsNullOrEmpty(Model.HinhAnh)) { <img src="@Html.Img(Model.HinhAnh)" alt="" height="60" class="mt-2 rounded" /> }</div>
 <div class="col-md-6 d-flex align-items-end gap-4"><div class="form-check"><input class="form-check-input" type="checkbox" id="TrangThai" name="TrangThai" value="true" @(Model.TrangThai ? "checked" : "") /><input type="hidden" name="TrangThai" value="false" /><label class="form-check-label" for="TrangThai">Xuất bản</label></div>
   <div class="form-check"><input class="form-check-input" type="checkbox" id="NoiBat" name="NoiBat" value="true" @(Model.NoiBat ? "checked" : "") /><input type="hidden" name="NoiBat" value="false" /><label class="form-check-label" for="NoiBat">Nổi bật</label></div></div>
</div><button class="btn btn-primary mt-3" type="submit">Lưu</button> <a class="btn btn-ghost mt-3" href="@Url.Action("Index")">Quay lại</a></div> }