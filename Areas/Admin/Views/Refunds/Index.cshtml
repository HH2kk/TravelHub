@model List<RefundRow>
<h1>Yêu cầu hoàn tiền</h1>
<form method="get" class="filters-bar d-flex gap-2"><select class="form-select" style="max-width:240px" name="status" aria-label="Trạng thái" onchange="this.form.submit()"><option value="">Mọi trạng thái</option>@foreach (var s in new[] { "PENDING", "MANUAL_REQUIRED", "REFUNDED", "REJECTED" }) { <option @(s == (string)ViewBag.Status ? "selected" : "")>@s</option> }</select></form>
<div class="alert alert-info small">Quy trình: <strong>PENDING</strong> → Duyệt → <strong>MANUAL_REQUIRED</strong> (hoàn qua cổng/ngân hàng) → nhập mã giao dịch hoàn thực tế → <strong>REFUNDED</strong>. Hệ thống chỉ hiển thị “đã hoàn” cho khách sau bước cuối. Tự động gọi API hoàn tiền của cổng chưa được bật (cần credential).</div>
<div class="panel"><div class="tbl-wrap"><table class="tbl"><thead><tr><th>#</th><th>Booking</th><th>Khách</th><th class="text-end">Số tiền</th><th>Lý do</th><th>Trạng thái</th><th>Xử lý</th></tr></thead><tbody>
@foreach (var r in Model) { <tr><td>@r.MaYeuCau</td><td><a href="@Url.Action("Details", "Bookings", new { id = r.MaDon })">@r.MaDonCode</a></td><td>@r.TenKhach</td><td class="text-end">@Html.Money(r.SoTien)</td><td class="small">@r.LyDo</td><td><span class="badge-st @(r.TrangThai == "REFUNDED" ? "ok" : r.TrangThai == "REJECTED" ? "bad" : "warn")">@r.TrangThai</span>@if (!string.IsNullOrEmpty(r.MaGiaoDichHoan)) { <div class="small">Mã: @r.MaGiaoDichHoan</div> }@if (!string.IsNullOrEmpty(r.LyDoTuChoi)) { <div class="small">@r.LyDoTuChoi</div> }</td>
 <td style="min-width:260px">
  @if (r.TrangThai == "PENDING") { using (Html.BeginForm("Approve", "Refunds", new { area = "Admin" }, FormMethod.Post, new { data_confirm = "Duyệt yêu cầu hoàn tiền này?", @class = "d-inline" })) { @Html.AntiForgeryToken() <input type="hidden" name="id" value="@r.MaYeuCau" /><button class="btn btn-primary btn-sm" type="submit">Duyệt</button> } }
  @if (r.TrangThai == "MANUAL_REQUIRED") { using (Html.BeginForm("Complete", "Refunds", new { area = "Admin" }, FormMethod.Post, new { data_confirm = "Xác nhận đã hoàn tiền thực tế cho khách?" })) { @Html.AntiForgeryToken() <input type="hidden" name="id" value="@r.MaYeuCau" /><div class="input-group input-group-sm"><input name="reference" class="form-control" placeholder="Mã giao dịch hoàn" required minlength="4" /><button class="btn btn-teal" type="submit">Đã hoàn</button></div> } }
  @if (r.TrangThai == "PENDING" || r.TrangThai == "MANUAL_REQUIRED") { using (Html.BeginForm("Reject", "Refunds", new { area = "Admin" }, FormMethod.Post, new { data_confirm = "Từ chối yêu cầu hoàn tiền?", @class = "mt-1" })) { @Html.AntiForgeryToken() <input type="hidden" name="id" value="@r.MaYeuCau" /><div class="input-group input-group-sm"><input name="reason" class="form-control" placeholder="Lý do từ chối" required /><button class="btn btn-outline-danger" type="submit">Từ chối</button></div> } }
 </td></tr> }
@if (!Model.Any()) { <tr><td colspan="7" class="text-center text-muted py-4">Không có yêu cầu.</td></tr> }</tbody></table></div></div>
@if (((List<dynamic>)ViewBag.Reconcile).Any()) { <div class="panel mt-3"><h2>Giao dịch cần đối soát</h2><div class="tbl-wrap"><table class="tbl"><thead><tr><th>GD</th><th>Booking</th><th class="text-end">Số tiền</th><th>Lý do</th><th>Mã GD cổng</th></tr></thead><tbody>
 @foreach (var r in (List<dynamic>)ViewBag.Reconcile) { <tr><td>@r.MaThanhToan</td><td>@r.MaDonCode</td><td class="text-end">@Html.Money((decimal)r.SoTien)</td><td>@r.TrangThaiCode</td><td>@r.MaGiaoDichCong</td></tr> }</tbody></table></div><p class="small text-muted mb-0">Các giao dịch trùng/đến muộn đã tự tạo yêu cầu hoàn tiền tương ứng.</p></div> }