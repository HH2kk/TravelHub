@model List<dynamic>
<div class="d-flex justify-content-between align-items-center mb-3"><h1 class="mb-0">Loại phòng</h1></div>
<form method="get" class="filters-bar d-flex gap-2"><select name="hotelId" class="form-select" style="max-width:320px" onchange="this.form.submit()" aria-label="Chỗ nghỉ"><option value="">Tất cả chỗ nghỉ</option>@foreach (var h in (List<dynamic>)ViewBag.Hotels) { <option value="@h.MaKS" @(ViewBag.HotelId != null && (int)ViewBag.HotelId == (int)h.MaKS ? "selected" : "")>@h.TenKS</option> }</select>
 @if (ViewBag.HotelId != null) { <a class="btn btn-primary" href="@Url.Action("Create", new { hotelId = (int)ViewBag.HotelId })">@Html.Icon("plus", 16) Thêm loại phòng</a> }</form>
<div class="panel"><div class="tbl-wrap"><table class="tbl"><thead><tr><th>Phòng</th><th>Chỗ nghỉ</th><th>Sức chứa</th><th class="text-end">Giá cơ bản</th><th>Tổng</th><th>Còn hôm nay</th><th>Ảnh</th><th>Trạng thái</th></tr></thead><tbody>
@foreach (var r in Model) { <tr><td><a href="@Url.Action("Edit", new { id = (int)r.MaPhong })"><strong>@r.TenPhong</strong></a><div class="small text-muted">@r.LoaiPhong</div></td><td>@r.TenKS</td><td>@r.SoNguoiToiDa</td><td class="text-end">@Html.Money((decimal)r.GiaPhong)</td><td>@r.SoLuong</td><td>@r.ConLaiHomNay</td><td>@r.Anh</td><td><span class="badge-st @((bool)r.TrangThai ? "ok" : "bad")">@((bool)r.TrangThai ? "Mở bán" : "Ngừng")</span></td></tr> }</tbody></table></div></div>