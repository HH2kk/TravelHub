@model List<dynamic>
<div class="d-flex justify-content-between align-items-center mb-3"><h1 class="mb-0">Chỗ nghỉ</h1><a class="btn btn-primary" href="@Url.Action("Create")">@Html.Icon("plus", 16) Thêm chỗ nghỉ</a></div>
<form method="get" class="filters-bar row g-2"><div class="col-md-5"><input class="form-control" name="q" value="@ViewBag.Q" placeholder="Tên chỗ nghỉ" aria-label="Tên" /></div><div class="col-md-3"><select class="form-select" name="status" aria-label="Trạng thái"><option value="">Tất cả</option><option value="1" @(ViewBag.Status == "1" ? "selected" : "")>Đang kinh doanh</option><option value="0" @(ViewBag.Status == "0" ? "selected" : "")>Ngừng kinh doanh</option></select></div><div class="col-md-2"><button class="btn btn-primary w-100" type="submit">Lọc</button></div></form>
<div class="panel"><div class="tbl-wrap"><table class="tbl"><thead><tr><th></th><th>Tên</th><th>Điểm đến</th><th>Sao</th><th>Loại</th><th class="text-end">Giá từ</th><th>Phòng</th><th>Đơn</th><th>Trạng thái</th><th></th></tr></thead><tbody>
@foreach (var r in Model) { <tr><td><img src="@Html.Img((string)r.HinhAnhDaiDien)" alt="" width="56" height="40" style="object-fit:cover;border-radius:6px" /></td><td><a href="@Url.Action("Edit", new { id = (int)r.MaKS })"><strong>@r.TenKS</strong></a></td><td>@r.TenDiaDiem</td><td>@r.SoSao</td><td>@r.LoaiHinh</td><td class="text-end">@Html.Money((decimal)(r.GiaTu ?? 0m))</td><td>@r.Phong</td><td>@r.Don</td><td><span class="badge-st @((bool)r.TrangThai ? "ok" : "bad")">@((bool)r.TrangThai ? "Đang bán" : "Ngừng")</span></td>
 <td>@using (Html.BeginForm("Deactivate", "Hotels", new { area = "Admin" }, FormMethod.Post, new { data_confirm = (bool)r.TrangThai ? "Ngừng kinh doanh chỗ nghỉ này? (Dữ liệu lịch sử được giữ lại)" : "Mở bán lại?" })) { @Html.AntiForgeryToken() <input type="hidden" name="id" value="@r.MaKS" /><input type="hidden" name="active" value="@((bool)r.TrangThai ? "false" : "true")" /><button class="btn btn-ghost btn-sm" type="submit">@((bool)r.TrangThai ? "Ngừng" : "Mở bán")</button> }</td></tr> }
</tbody></table></div></div>