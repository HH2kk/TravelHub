@model SearchResult
@if (Model.Pages > 1)
{
  <nav aria-label="Phân trang"><ul class="pagination justify-content-center flex-wrap mt-4">
    @for (int p = 1; p <= Model.Pages; p++)
    {
      if (p == 1 || p == Model.Pages || Math.Abs(p - Model.Page) <= 2)
      { <li class="page-item @(p == Model.Page ? "active" : "")"><a class="page-link" href="@Url.PageUrl(p)" @(p == Model.Page ? "aria-current=page" : "")>@p</a></li> }
      else if (Math.Abs(p - Model.Page) == 3) { <li class="page-item disabled"><span class="page-link">…</span></li> }
    }
  </ul></nav>
}