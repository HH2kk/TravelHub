@model ForgotPasswordViewModel
<div class="auth-wrap"><div class="box"><h1 class="h3 mb-3">Quên mật khẩu</h1>
@if (ViewBag.Sent == true) { <div class="alert alert-success">Nếu email tồn tại trong hệ thống, chúng tôi đã gửi liên kết đặt lại mật khẩu (hiệu lực 1 giờ).</div> }
@using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post)) { @Html.AntiForgeryToken()
 <div class="mb-3"><label class="form-label" for="Email">Email đã đăng ký</label>@Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email" })@Html.ValidationMessageFor(m => m.Email)</div>
 <button class="btn btn-primary w-100" type="submit">Gửi liên kết</button> }
<p class="small mt-3 mb-0"><a href="@Url.Action("Login")">Quay lại đăng nhập</a></p></div></div>
@section scripts { @Scripts.Render("~/bundles/jqueryval") }