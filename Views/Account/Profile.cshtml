@model ProfileViewModel
<div class="container py-4" style="max-width:760px"><h1 class="h2 mb-3">Hồ sơ của tôi</h1>
@using (Html.BeginForm("Profile", "Account", FormMethod.Post, new { enctype = "multipart/form-data" })) { @Html.AntiForgeryToken() @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2" })
 <div class="box"><div class="d-flex align-items-center gap-3 mb-3"><img src="@(string.IsNullOrEmpty(Model.AvatarUrl) ? "/Content/images/placeholder.svg" : Model.AvatarUrl)" alt="Ảnh đại diện" width="72" height="72" class="rounded-circle" style="object-fit:cover" />
  <div><label class="form-label" for="avatar">Ảnh đại diện (JPG/PNG/WebP, ≤ 4 MB)</label><input type="file" id="avatar" name="avatar" accept="image/jpeg,image/png,image/webp" class="form-control" /></div></div>
 <div class="row g-3"><div class="col-md-6"><label class="form-label" for="FullName">Họ và tên</label>@Html.TextBoxFor(m => m.FullName, new { @class = "form-control" })@Html.ValidationMessageFor(m => m.FullName)</div>
 <div class="col-md-6"><label class="form-label" for="Phone">Số điện thoại</label>@Html.TextBoxFor(m => m.Phone, new { @class = "form-control", type = "tel" })@Html.ValidationMessageFor(m => m.Phone)</div>
 <div class="col-md-6"><label class="form-label" for="BirthDate">Ngày sinh</label>@Html.TextBoxFor(m => m.BirthDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })</div>
 <div class="col-md-6"><label class="form-label" for="Gender">Giới tính</label>@Html.DropDownListFor(m => m.Gender, new SelectList(new[] { "", "Nam", "Nữ", "Khác" }, Model.Gender), new { @class = "form-select" })</div>
 <div class="col-12"><label class="form-label">Email</label><input class="form-control" value="@Model.Email" readonly /> @if (Model.EmailConfirmed) { <span class="chip teal mt-1">@Html.Icon("check", 12) Đã xác minh</span> } else { <span class="chip mt-1" style="background:#fef3c7;color:#92400e">Chưa xác minh</span> }</div></div>
 <button class="btn btn-primary mt-3" type="submit">Lưu thay đổi</button></div> }
<div class="mt-3"><a href="@Url.Action("ChangePassword")">Đổi mật khẩu</a> · <a href="@Url.Action("My", "Booking")">Đặt phòng của tôi</a></div></div>
@section scripts { @Scripts.Render("~/bundles/jqueryval") }