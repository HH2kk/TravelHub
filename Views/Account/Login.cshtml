@model LoginViewModel
<div class="auth-wrap"><div class="box"><h1 class="h3 mb-3">Đăng nhập</h1>
@using (Html.BeginForm("Login", "Account", FormMethod.Post)) { @Html.AntiForgeryToken() @Html.HiddenFor(m => m.ReturnUrl) @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2" })
 <div class="mb-3"><label class="form-label" for="UserName">Tên đăng nhập</label>@Html.TextBoxFor(m => m.UserName, new { @class = "form-control", autocomplete = "username", autofocus = "autofocus" })@Html.ValidationMessageFor(m => m.UserName)</div>
 <div class="mb-3"><label class="form-label" for="Password">Mật khẩu</label>@Html.PasswordFor(m => m.Password, new { @class = "form-control", autocomplete = "current-password" })@Html.ValidationMessageFor(m => m.Password)</div>
 <button class="btn btn-primary w-100" type="submit">Đăng nhập</button> }
<div class="d-flex justify-content-between mt-3 small"><a href="@Url.Action("ForgotPassword")">Quên mật khẩu?</a><a href="@Url.Action("Register")">Tạo tài khoản mới</a></div></div></div>
@section scripts { @Scripts.Render("~/bundles/jqueryval") }