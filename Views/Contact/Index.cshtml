@model TravelHub.Controllers.ContactViewModel
<div class="container py-4"><div class="row g-4"><div class="col-lg-7"><h1 class="h2">Liên hệ &amp; hỗ trợ</h1><p class="text-muted">Gửi yêu cầu về đặt phòng, thanh toán, hủy hoặc hoàn tiền. Chúng tôi phản hồi qua email.</p>
 @using (Html.BeginForm()) { @Html.AntiForgeryToken() @Html.ValidationSummary(true, "", new { @class = "text-danger" })
  <div class="row g-3"><div class="col-md-6"><label class="form-label" for="Name">Họ tên</label>@Html.TextBoxFor(m => m.Name, new { @class = "form-control" })@Html.ValidationMessageFor(m => m.Name)</div>
  <div class="col-md-6"><label class="form-label" for="Email">Email</label>@Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email" })@Html.ValidationMessageFor(m => m.Email)</div>
  <div class="col-12"><label class="form-label" for="Subject">Tiêu đề</label>@Html.TextBoxFor(m => m.Subject, new { @class = "form-control" })@Html.ValidationMessageFor(m => m.Subject)</div>
  <div class="col-12"><label class="form-label" for="Message">Nội dung</label>@Html.TextAreaFor(m => m.Message, 6, 40, new { @class = "form-control" })@Html.ValidationMessageFor(m => m.Message)</div>
  <div class="col-12"><button class="btn btn-primary" type="submit">Gửi yêu cầu</button></div></div> } </div>
 <div class="col-lg-5"><div class="box"><h2 class="h5">Thông tin hỗ trợ</h2><p class="mb-1">@Html.Icon("mail", 16) @AppConfig.Setting("EmailHoTro", "support@travelhub.vn")</p><p class="small text-muted mb-0">Nếu liên quan đến đơn đặt phòng, vui lòng nêu rõ mã đặt phòng.</p></div></div></div></div>
@section scripts { @Scripts.Render("~/bundles/jqueryval") }