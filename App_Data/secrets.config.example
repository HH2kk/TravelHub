<?xml version="1.0" encoding="utf-8"?>
<!-- Sao chép thành secrets.config (KHÔNG commit). File này được nạp qua <appSettings file="App_Data\secrets.config"> -->
<appSettings>
  <add key="Vnpay:TmnCode" value="" />
  <add key="Vnpay:HashSecret" value="" />
  <!-- Dev: ghi email ra thư mục thay vì gửi thật -->
  <add key="Smtp:PickupDirectory" value="C:\TravelHub\App_Data\mail" />
  <!-- Production SMTP:
  <add key="Smtp:Host" value="smtp.example.com" /><add key="Smtp:Port" value="587" /><add key="Smtp:EnableSsl" value="true" />
  <add key="Smtp:User" value="" /><add key="Smtp:Password" value="" /><add key="Smtp:From" value="no-reply@yourdomain.vn" /> -->
</appSettings>
